{
  "architecture": {
    "bias": null,
    "context_len": 1024,
    "d_model": 640,
    "dropout": 0.0,
    "ffn_multiplier": 2.0,
    "n_heads": 10,
    "n_layer": 16,
    "name": "modern_decoder",
    "rope_base": 10000.0,
    "vocab_size": 50257,
    "weight_tying": true
  },
  "data": {
    "data_fraction": "100%",
    "manifest_dir": "data/manifests",
    "sources": [
      {
        "glob": "**/*.bin",
        "name": "fineweb_edu",
        "notes": "Primary educational web corpus from HuggingFaceFW/fineweb-edu.",
        "path": "data/fineweb-edu",
        "weight": 0.75
      },
      {
        "glob": "**/*.bin",
        "name": "openwebtext",
        "notes": "Template slot for OpenWebText-style general web data.",
        "path": "data/openwebtext",
        "weight": 0.15
      },
      {
        "glob": "**/*.bin",
        "name": "wikimedia",
        "notes": "Template slot for Wikipedia or Wikimedia-derived text.",
        "path": "data/wikimedia",
        "weight": 0.09
      },
      {
        "glob": "**/*.bin",
        "name": "arxiv_abstracts",
        "notes": "Template slot for technical/reference abstracts.",
        "path": "data/arxiv-abstracts",
        "weight": 0.01
      }
    ],
    "val_data_path": "val.bin"
  },
  "name": "full_v2_mixture_template",
  "optimizer": {
    "adamw_lr": 0.0003,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08,
    "momentum": 0.95,
    "muon_lr": 0.02,
    "muon_ns_steps": 5,
    "name": "muon_hybrid",
    "nesterov": true,
    "weight_decay": 0.1
  },
  "train": {
    "batch_size": 16,
    "checkpoint_dir": "checkpoints",
    "compile": false,
    "context_schedule": {
      "end_context_len": 1024,
      "name": "fixed",
      "ramp_steps": 0,
      "start_context_len": null,
      "switch_step": 0
    },
    "device": "cuda",
    "eval_batch_size": 8,
    "eval_batches": null,
    "eval_interval": 500,
    "grad_accum_steps": 6,
    "grad_clip": 1.0,
    "log_cuda_memory": true,
    "log_interval": 50,
    "max_steps": 15000,
    "min_lr_ratio": 0.1,
    "precision": "bf16",
    "resume_from": null,
    "save_interval": 500,
    "seed": 1337,
    "submission_dir": "submission",
    "warmup_steps": 100
  }
}